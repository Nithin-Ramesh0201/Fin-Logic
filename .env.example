# Copy this file to .env and fill in your own values.
# Get a Groq key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Firebase web app config (Firebase Console -> Project Settings -> General)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional: for hosting, paste the entire service account JSON on one line
# instead of using a serviceAccountKey.json file.
# FIREBASE_SERVICE_ACCOUNT=

# Optional
# PORT=3000
